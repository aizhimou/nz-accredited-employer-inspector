---
import BrandMark from "../components/BrandMark.astro";
import logo from "../assets/logo-no-bg-mark.png";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
  pageKind?: "product" | "privacy" | "guide" | "changelog" | "insights" | "open-data";
  markdownAlternate?: string;
}

const {
  title = "NZ Accredited Employer Inspector | Chrome Extension",
  description = "Check whether employers on SEEK and LinkedIn are accredited with Immigration New Zealand before you apply. A free, open-source Chrome extension.",
  pageKind = "product",
  markdownAlternate = "/index.md",
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og-image.png", Astro.site);
const repositoryUrl = "https://github.com/aizhimou/nz-accredited-employer-inspector";
const chromeWebStoreUrl = "https://chromewebstore.google.com/detail/nz-accredited-employer-in/gjcifpaoplkboeefndngnglhjhldkbbg";
const authorUrl = "https://zemo.bio/";
const videoUrl = "https://www.youtube.com/watch?v=85SEJU-aHrQ";
const videoEmbedUrl = "https://www.youtube-nocookie.com/embed/85SEJU-aHrQ";
const primaryNavigation = [
  { href: "/how-results-work/", label: "How results work", current: Astro.url.pathname.startsWith("/how-results-work") },
  { href: "/insights/", label: "Insights", current: Astro.url.pathname.startsWith("/insights") },
  { href: "/open-data/", label: "Open data", current: Astro.url.pathname.startsWith("/open-data") },
  { href: "/public-api/", label: "Public API", current: Astro.url.pathname.startsWith("/public-api") },
  { href: "/changelog/", label: "Changelog", current: Astro.url.pathname.startsWith("/changelog") },
];
const productStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "SoftwareApplication",
      name: "NZ Accredited Employer Inspector",
      applicationCategory: "BrowserApplication",
      operatingSystem: "Chrome",
      description,
      url: canonicalUrl.href,
      image: socialImageUrl.href,
      codeRepository: repositoryUrl,
      downloadUrl: chromeWebStoreUrl,
      softwareVersion: "0.9.0",
      isAccessibleForFree: true,
      author: { "@id": `${authorUrl}#person` },
      sameAs: [repositoryUrl, chromeWebStoreUrl, videoUrl],
      featureList: [
        "Checks employer accreditation from LinkedIn and SEEK",
        "Uses Immigration New Zealand data",
        "Shows accreditation expiry and verification provenance",
        "Supports user-confirmed platform-to-employer associations",
      ],
    },
    {
      "@type": "WebSite",
      name: "NZ Accredited Employer Inspector",
      url: canonicalUrl.origin,
      inLanguage: "en-NZ",
      publisher: { "@id": `${authorUrl}#person` },
    },
    {
      "@type": "Person",
      "@id": `${authorUrl}#person`,
      name: "Zemo Ai",
      url: authorUrl,
    },
    {
      "@type": "VideoObject",
      name: "Check NZ Employer Accreditation on SEEK & LinkedIn",
      description: "A short walkthrough of NZ Accredited Employer Inspector checking employer accreditation directly on SEEK and LinkedIn.",
      thumbnailUrl: "https://i.ytimg.com/vi/85SEJU-aHrQ/hqdefault.jpg",
      uploadDate: "2026-08-05T23:00:28-07:00",
      duration: "PT16S",
      contentUrl: videoUrl,
      embedUrl: videoEmbedUrl,
    },
    {
      "@type": "FAQPage",
      mainEntity: [
        {
          "@type": "Question",
          name: "Does the extension decide whether I can get a visa?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It displays published employer accreditation data and matching context. It is not immigration or legal advice.",
          },
        },
        {
          "@type": "Question",
          name: "Where does accreditation data come from?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "Employer names, NZBNs and accreditation expiry dates come from Immigration New Zealand.",
          },
        },
        {
          "@type": "Question",
          name: "Is this an official Immigration New Zealand product?",
          acceptedAnswer: {
            "@type": "Answer",
            text: "No. It is an independent open-source project that links to the official Immigration New Zealand accredited employer list.",
          },
        },
      ],
    },
  ],
};
const privacyStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      name: title,
      description,
      url: canonicalUrl.href,
      dateModified: "2026-08-06",
      inLanguage: "en-NZ",
      isPartOf: {
        "@type": "WebSite",
        name: "NZ Accredited Employer Inspector",
        url: canonicalUrl.origin,
      },
      author: { "@id": `${authorUrl}#person` },
      about: {
        "@type": "SoftwareApplication",
        name: "NZ Accredited Employer Inspector",
        applicationCategory: "BrowserApplication",
        operatingSystem: "Chrome",
      },
    },
    {
      "@type": "Person",
      "@id": `${authorUrl}#person`,
      name: "Zemo Ai",
      url: authorUrl,
    },
  ],
};
const guideStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Article",
      headline: title,
      description,
      url: canonicalUrl.href,
      dateModified: "2026-08-10",
      inLanguage: "en-NZ",
      author: { "@id": `${authorUrl}#person` },
      publisher: { "@id": `${authorUrl}#person` },
      isPartOf: {
        "@type": "WebSite",
        name: "NZ Accredited Employer Inspector",
        url: canonicalUrl.origin,
      },
      about: {
        "@type": "SoftwareApplication",
        name: "NZ Accredited Employer Inspector",
        applicationCategory: "BrowserApplication",
        operatingSystem: "Chrome",
      },
    },
    {
      "@type": "Person",
      "@id": `${authorUrl}#person`,
      name: "Zemo Ai",
      url: authorUrl,
    },
  ],
};
const changelogStructuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "CollectionPage",
      name: title,
      description,
      url: canonicalUrl.href,
      dateModified: "2026-08-16",
      inLanguage: "en-NZ",
      isPartOf: {
        "@type": "WebSite",
        name: "NZ Accredited Employer Inspector",
        url: canonicalUrl.origin,
      },
      author: { "@id": `${authorUrl}#person` },
      about: {
        "@type": "SoftwareApplication",
        name: "NZ Accredited Employer Inspector",
        softwareVersion: "0.9.0",
        applicationCategory: "BrowserApplication",
        operatingSystem: "Chrome",
      },
    },
    {
      "@type": "Person",
      "@id": `${authorUrl}#person`,
      name: "Zemo Ai",
      url: authorUrl,
    },
  ],
};
const insightsStructuredData = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: title,
  description,
  url: canonicalUrl.href,
  dateModified: "2026-08-18",
  inLanguage: "en-NZ",
  isPartOf: {
    "@type": "WebSite",
    name: "NZ Accredited Employer Inspector",
    url: canonicalUrl.origin,
  },
  about: {
    "@type": "Dataset",
    name: "New Zealand accredited employer insights",
    creator: { "@type": "Organization", name: "Immigration New Zealand" },
  },
};
const openDataStructuredData = {
  "@context": "https://schema.org",
  "@type": "Dataset",
  name: "NZ Accredited Employer Inspector employer records snapshots",
  description,
  url: canonicalUrl.href,
  dateModified: "2026-08-19",
  inLanguage: "en-NZ",
  creator: { "@type": "Person", name: "Zemo Ai", url: authorUrl },
  isAccessibleForFree: true,
  distribution: {
    "@type": "DataDownload",
    name: "Snapshot catalog",
    encodingFormat: "application/json",
    contentUrl: "https://data.nzaei.zemo.bio/catalog.json",
  },
};
const structuredData = pageKind === "privacy"
  ? privacyStructuredData
  : pageKind === "guide"
    ? guideStructuredData
    : pageKind === "changelog"
      ? changelogStructuredData
      : pageKind === "insights"
        ? insightsStructuredData
        : pageKind === "open-data"
          ? openDataStructuredData
        : productStructuredData;
---

<!doctype html>
<html lang="en-NZ">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="author" content="Zemo Ai" />
    <meta name="theme-color" content="#083b45" />
    <meta name="robots" content="index, follow" />
    <link rel="icon" href={logo.src} type="image/png" />
    <link rel="apple-touch-icon" href={logo.src} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="author" href={authorUrl} />
    <link rel="privacy-policy" href="/privacy/" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" href={markdownAlternate} type="text/markdown" title="Markdown version" />
    <link rel="describedby" href="/llms.txt" type="text/markdown" title="Agent-readable site index" />
    <link rel="api-catalog" href="/.well-known/api-catalog" type="application/linkset+json" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NZ Accredited Employer Inspector" />
    <meta property="og:locale" content="en_NZ" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="NZ Accredited Employer Inspector checking an employer before a job application" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content="NZ Accredited Employer Inspector checking an employer before a job application" />
    <!-- Privacy-friendly analytics by Plausible -->
    <script async is:inline src="https://plausible.asimov.top/js/pa-JzeixigPQXOrOeaMqtUc5.js"></script>
    <script is:inline>
      window.plausible = window.plausible || function () {
        (plausible.q = plausible.q || []).push(arguments);
      };
      plausible.init = plausible.init || function (options) {
        plausible.o = options || {};
      };
      plausible.init();
    </script>
    <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="shell nav-shell">
        <a class="brand-link" href="/" aria-label="NZ Accredited Employer Inspector home">
          <BrandMark />
        </a>
        <nav class="desktop-nav" aria-label="Primary navigation">
          {primaryNavigation.map((link) => (
            <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
          ))}
          <a class="nav-cta" href={repositoryUrl}>GitHub <span aria-hidden="true">↗</span></a>
        </nav>
      </div>
      <nav class="mobile-nav shell" aria-label="Primary navigation">
        {primaryNavigation.map((link) => (
          <a href={link.href} aria-current={link.current ? "page" : undefined}>{link.label}</a>
        ))}
        <a href={repositoryUrl}>GitHub <span aria-hidden="true">↗</span></a>
      </nav>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <BrandMark />
          <p>Open-source clarity for people navigating New Zealand’s job market.</p>
          <p class="maker">Built in Tāmaki Makaurau by <a href={authorUrl} rel="author">Zemo Ai</a>.</p>
        </div>
        <div class="footer-links" aria-label="Project links">
          <a href={repositoryUrl}>Source code</a>
          <a href={`${repositoryUrl}/blob/main/docs/extension-api-ssot.md`}>Technical contract</a>
          <a href="https://www.immigration.govt.nz/work/requirements-for-work-visas/approved-employers/accredited-employer-list/">Official INZ list</a>
          <a href="/how-results-work/">How results work</a>
          <a href="/insights/">Insights</a>
          <a href="/open-data/">Open data</a>
          <a href="/public-api/">Public API</a>
          <a href="/changelog/">Changelog</a>
          <a href="/privacy/">Privacy policy</a>
          <a href={markdownAlternate}>Read as Markdown</a>
        </div>
        <p class="legal">
          Not immigration or legal advice. Accreditation data is sourced from Immigration New Zealand; platform associations may be community-confirmed.
        </p>
      </div>
    </footer>
  </body>
</html>
