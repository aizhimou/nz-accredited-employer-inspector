---
import BaseLayout from "../layouts/BaseLayout.astro";
import linkedInLogo from "../assets/LI-Logo.png";
import seekLogo from "../assets/Seek_Limited-logo.svg";

const repositoryUrl = "https://github.com/aizhimou/nz-accredited-employer-inspector";
const chromeExtensionDownloadUrl =
  "https://chromewebstore.google.com/detail/nz-accredited-employer-in/gjcifpaoplkboeefndngnglhjhldkbbg";
const sourceModel = [
  {
    label: "Official fact",
    title: "Accreditation",
    copy: "Employer name, NZBN, expiry date and verification time come from Immigration New Zealand.",
    source: "Source · INZ",
    tone: "official",
  },
  {
    label: "Derived match",
    title: "Exact legal name",
    copy: "A sole official employer can be selected only when its normalised legal name exactly matches the page.",
    source: "Source · Worker-derived",
    tone: "derived",
  },
  {
    label: "Community context",
    title: "Platform association",
    copy: "People can confirm which NZBN belongs to a LinkedIn company or SEEK advertiser—and change it later.",
    source: "Source · Extension users",
    tone: "community",
  },
  {
    label: "Time-bound evidence",
    title: "No published match",
    copy: "A name lookup with no result currently lasts seven days. It is never presented as proof of non-accreditation.",
    source: "Source · INZ lookup",
    tone: "caution",
  },
];

const agentResources = [
  ["/llms.txt", "Short machine-readable site map"],
  ["/llms-full.txt", "Complete product context in Markdown"],
  ["/index.md", "Landing page without presentation markup"],
  ["/privacy.md", "Extension privacy policy in Markdown"],
  ["/.well-known/api-catalog", "RFC 9727 API discovery"],
  ["/api/openapi.json", "OpenAPI 3.1 service description"],
  ["/sitemap.xml", "Canonical crawl map"],
];
---

<BaseLayout>
  <section class="hero" aria-labelledby="hero-title">
    <svg class="contours" viewBox="0 0 1600 760" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-90 650C233 460 405 747 740 540S1224 370 1690 102"></path>
      <path d="M-110 709C240 505 430 784 772 581S1260 405 1710 153"></path>
      <path d="M-130 770C255 553 460 820 806 623S1288 448 1730 205"></path>
    </svg>
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">A clearer job search in Aotearoa</p>
        <h1 id="hero-title">Know who’s accredited. <em>Before you apply.</em></h1>
        <p class="hero-lede">
          A small Chrome extension that checks employers on LinkedIn and SEEK against Immigration New Zealand data—right where you’re job hunting.
        </p>
        <div class="button-row">
          <a class="button button-primary" href={chromeExtensionDownloadUrl}>
            Download for Chrome
            <span aria-hidden="true">→</span>
          </a>
          <a class="button button-secondary" href="#demo" data-play-demo>
            See how it works
            <span aria-hidden="true">▶</span>
          </a>
        </div>
        <ul class="hero-notes" aria-label="Product characteristics">
          <li>Open source</li>
          <li>Human-triggered</li>
          <li>No account access</li>
        </ul>
      </div>

      <figure class="inspector-demo" aria-label="Example accreditation result shown inside a job page">
        <figcaption>Illustrative result</figcaption>
        <div class="browser-bar" aria-hidden="true">
          <span></span><span></span><span></span>
          <div>nz.seek.com / job</div>
        </div>
        <div class="job-card">
          <div class="job-meta">Software engineering · Auckland</div>
          <h2>Senior Platform Engineer</h2>
          <div class="company-line">
            <span class="company-avatar" aria-hidden="true">K</span>
            <div>
              <strong>Koru Digital Limited</strong>
              <small>Tāmaki Makaurau</small>
            </div>
          </div>
          <div class="widget">
            <div class="widget-trigger">
              <span class="status-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="m6.5 12.3 3.4 3.4 7.6-8"></path></svg>
              </span>
              <strong>Accredited in NZ</strong>
              <span class="chevron" aria-hidden="true">⌄</span>
            </div>
            <div class="result-panel">
              <div class="result-heading">
                <div>
                  <small>NZ accredited employer</small>
                  <strong>Koru Digital Limited</strong>
                </div>
                <span>Official INZ data</span>
              </div>
              <div class="provenance-row">
                <span>Employer match</span>
                <strong>Community-confirmed association</strong>
              </div>
              <div class="employer-row">
                <span class="result-dot"></span>
                <div>
                  <strong>Koru Digital Limited</strong>
                  <dl>
                    <div><dt>NZBN</dt><dd>94•••••••••••</dd></div>
                    <div><dt>Accredited until</dt><dd>18 Mar 2027</dd></div>
                    <div><dt>Verified with INZ</dt><dd>Today</dd></div>
                  </dl>
                </div>
              </div>
              <div class="result-footer">
                <span>Official facts · Community association</span>
                <span>View INZ list ↗</span>
              </div>
            </div>
          </div>
        </div>
        <div class="evidence-path" aria-label="Data provenance path">
          <span><b>01</b> SEEK / LinkedIn</span>
          <i aria-hidden="true"></i>
          <span><b>02</b> Inspector</span>
          <i aria-hidden="true"></i>
          <span><b>03</b> INZ</span>
        </div>
      </figure>
    </div>
  </section>

  <aside class="support-strip" aria-label="Supported job platforms">
    <div class="shell support-inner">
      <div class="platforms">
        <img src={linkedInLogo.src} alt="LinkedIn" width={linkedInLogo.width} height={linkedInLogo.height} />
        <img src={seekLogo.src} alt="SEEK NZ" />
      </div>
    </div>
  </aside>

  <section class="demo section" id="demo" aria-labelledby="demo-title">
    <div class="shell">
      <div class="demo-heading">
        <div class="section-heading">
          <p class="eyebrow">Product walkthrough</p>
          <h2 id="demo-title">See the Inspector in action.</h2>
        </div>
        <div class="demo-intro">
          <p>Watch a quick check on a supported job page—from the first click to the evidence behind the result.</p>
          <span>16-second walkthrough · Real extension, real pages</span>
        </div>
      </div>
      <div class="video-shell" id="demo-video">
        <iframe
          src="https://www.youtube-nocookie.com/embed/85SEJU-aHrQ?rel=0&modestbranding=1&playsinline=1"
          title="Check NZ Employer Accreditation on SEEK and LinkedIn"
          loading="lazy"
          referrerpolicy="strict-origin-when-cross-origin"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>

  <section class="how section" id="how-it-works" aria-labelledby="how-title">
    <div class="shell">
      <div class="section-heading how-heading">
        <p class="eyebrow">One deliberate check</p>
        <h2 id="how-title">Useful evidence, without leaving the job page.</h2>
        <p>The extension waits for you. No background scraping, bulk lookup or automatic call happens on page load.</p>
      </div>
      <ol class="steps">
        <li>
          <span class="step-marker">On the page</span>
          <h3>Find a role or company</h3>
          <p>Browse supported LinkedIn company and job pages, or SEEK NZ jobs and company profiles as usual.</p>
        </li>
        <li>
          <span class="step-marker">Your choice</span>
          <h3>Click one clear control</h3>
          <p>Select “Check NZ accreditation”. A check may make at most one live request to INZ.</p>
        </li>
        <li>
          <span class="step-marker">In context</span>
          <h3>Read the result and its source</h3>
          <p>See the legal employer, NZBN, expiry, last verification and how the page was matched.</p>
        </li>
      </ol>
    </div>
  </section>

  <section class="coverage section" aria-labelledby="coverage-title">
    <div class="shell coverage-grid">
      <div class="coverage-copy">
        <p class="eyebrow">Built for the messy middle</p>
        <h2 id="coverage-title">Company names rarely line up perfectly.</h2>
        <p>
          A trading name on a job ad can differ from the legal employer published by INZ. The Inspector keeps plausible candidates visible and asks you to confirm rather than silently guessing.
        </p>
        <ul class="feature-list">
          <li><span aria-hidden="true">✓</span> Exact legal-name matches are labelled as automatic</li>
          <li><span aria-hidden="true">✓</span> Fuzzy candidates always require a person’s choice</li>
          <li><span aria-hidden="true">✓</span> Every alternative stays available to inspect or select</li>
        </ul>
      </div>
      <div class="match-sheet" aria-label="Example of matching a platform name to official employer candidates">
        <div class="sheet-header">
          <span>Employer match</span>
          <small>Review required</small>
        </div>
        <div class="platform-name">
          <small>Name shown on SEEK</small>
          <strong>Koru Digital</strong>
        </div>
        <div class="connector" aria-hidden="true"><span></span></div>
        <div class="candidate selected">
          <span class="radio"></span>
          <div><strong>Koru Digital Limited</strong><small>NZBN 94••••••••••• · Accredited</small></div>
          <span class="selection">Your choice</span>
        </div>
        <div class="candidate">
          <span class="radio"></span>
          <div><strong>Koru Digital Services Limited</strong><small>NZBN 94••••••••••• · Accredited</small></div>
          <span class="choose">Use this employer</span>
        </div>
        <p>Legal employer records are official INZ data. This platform association is community data.</p>
      </div>
    </div>
  </section>

  <section class="trust section" id="trust" aria-labelledby="trust-title">
    <div class="shell">
      <div class="section-heading trust-heading">
        <p class="eyebrow">Provenance over promises</p>
        <h2 id="trust-title">Four kinds of evidence. Never blurred together.</h2>
        <p>Accreditation and identity matching answer different questions. The interface keeps their source and confidence visible.</p>
      </div>
      <div class="source-grid">
        {sourceModel.map((item) => (
          <article class:list={["source-card", item.tone]}>
            <span class="source-label">{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <small>{item.source}</small>
          </article>
        ))}
      </div>
      <aside class="truth-note">
        <span aria-hidden="true">!</span>
        <p><strong>Important:</strong> “No published INZ match” is not proof that an employer is unaccredited. Check the legal name or ask the employer directly.</p>
      </aside>
    </div>
  </section>

  <section class="privacy section" aria-labelledby="privacy-title">
    <div class="shell privacy-grid">
      <div class="privacy-statement">
        <p class="eyebrow">Small by design</p>
        <h2 id="privacy-title">No account data. No mystery checks.</h2>
      </div>
      <div class="privacy-details">
        <article>
          <span>01</span>
          <h3>Explicit user action</h3>
          <p>INZ is contacted only after a click, never automatically when a page loads.</p>
        </article>
        <article>
          <span>02</span>
          <h3>Installation identity only</h3>
          <p>A random UUID is stored locally and hashed by the API. It is not derived from LinkedIn or SEEK account data.</p>
        </article>
        <article>
          <span>03</span>
          <h3>Open implementation</h3>
          <p>The extension, Worker, D1 schema, API contract and tests are available in the public repository.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="agents section" id="agents" aria-labelledby="agents-title">
    <div class="shell agents-grid">
      <div class="agents-copy">
        <p class="eyebrow">Readable by people and agents</p>
        <h2 id="agents-title">The page explains itself without a browser.</h2>
        <p>
          Semantic HTML and structured metadata describe the product for search and AI systems. Stable text endpoints expose the same core facts with less markup and fewer tokens.
        </p>
        <a class="text-link" href="/llms.txt">Open the agent-readable index <span aria-hidden="true">→</span></a>
      </div>
      <div class="agent-terminal" aria-label="Agent-discoverable resources">
        <div class="terminal-title"><span></span><span></span><span></span><code>agent-discovery</code></div>
        <div class="terminal-body">
          <p><span>$</span> GET /robots.txt</p>
          <p class="terminal-response">200 · crawl policy + sitemap</p>
          <div class="resource-list">
            {agentResources.map(([path, purpose]) => (
              <a href={path}>
                <code>{path}</code>
                <span>{purpose}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="faq section" aria-labelledby="faq-title">
    <div class="shell faq-grid">
      <div class="section-heading">
        <p class="eyebrow">Good to know</p>
        <h2 id="faq-title">Straight answers.</h2>
      </div>
      <div class="questions">
        <details>
          <summary>Does the extension decide whether I can get a visa?</summary>
          <p>No. It displays published employer accreditation data and matching context. It is not immigration or legal advice.</p>
        </details>
        <details>
          <summary>Where does accreditation data come from?</summary>
          <p>Employer names, NZBNs and accreditation expiry dates come from Immigration New Zealand. The API records when it accepted that data.</p>
        </details>
        <details>
          <summary>Why can a result require confirmation?</summary>
          <p>The brand or advertiser name on a platform may map to several legal employers. The extension shows candidates instead of turning a fuzzy match into a fact.</p>
        </details>
        <details>
          <summary>Is this an official Immigration New Zealand product?</summary>
          <p>No. It is an independent open-source project that links back to the official INZ accredited employer list.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="final-cta" aria-labelledby="cta-title">
    <div class="shell final-cta-inner">
      <div>
        <p class="eyebrow">Built in Aotearoa</p>
        <h2 id="cta-title">Bring clarity to your next application.</h2>
      </div>
      <div>
        <p>Review the implementation, run the extension locally, or help improve platform coverage.</p>
        <a class="button button-primary" href={repositoryUrl}>Explore on GitHub <span aria-hidden="true">↗</span></a>
      </div>
    </div>
  </section>

<script>
  const playDemoLink = document.querySelector<HTMLAnchorElement>("[data-play-demo]");
  const demoFrame = document.querySelector<HTMLIFrameElement>("#demo-video iframe");

  playDemoLink?.addEventListener("click", () => {
    if (demoFrame === null || demoFrame.src.includes("autoplay=1")) return;
    const videoUrl = new URL(demoFrame.src);
    videoUrl.searchParams.set("autoplay", "1");
    demoFrame.src = videoUrl.href;
  });
</script>
</BaseLayout>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(5rem, 10vw, 9rem) clamp(4.5rem, 8vw, 7rem);
    background:
      radial-gradient(circle at 82% 25%, rgb(223 242 235 / 90%), transparent 31rem),
      linear-gradient(140deg, #f7faf9 0%, #edf5f3 100%);
  }

  .contours {
    position: absolute;
    inset: auto -5% -5rem;
    width: 110%;
    height: 80%;
    fill: none;
    opacity: 0.75;
    pointer-events: none;
    stroke: #c5dcd6;
    stroke-width: 1.2;
    vector-effect: non-scaling-stroke;
  }

  .hero-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(29rem, 0.88fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7.5rem);
  }

  .hero-copy {
    display: grid;
    justify-items: start;
    gap: 1.8rem;
  }

  h1 em {
    color: var(--pounamu);
    font-style: normal;
  }

  .hero-lede {
    max-width: 57ch;
    color: var(--slate);
    font-size: clamp(1.08rem, 1.7vw, 1.32rem);
    line-height: 1.55;
  }

  .hero-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
    padding: 0;
    color: var(--slate);
    font-size: 0.78rem;
    font-weight: 650;
    list-style: none;
  }

  .hero-notes li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
  }

  .hero-notes li::before {
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 50%;
    background: var(--pounamu);
    content: "";
  }

  .inspector-demo {
    position: relative;
    border: 1px solid rgb(187 213 207 / 90%);
    border-radius: 1.25rem;
    background: rgb(255 255 255 / 78%);
    box-shadow: var(--shadow-card);
    transform: rotate(1.2deg);
  }

  .inspector-demo > figcaption {
    position: absolute;
    top: -2rem;
    right: 0;
    color: var(--slate);
    font-family: var(--font-utility);
    font-size: 0.65rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.75rem 0.9rem;
    border-bottom: 1px solid var(--line-light);
  }

  .browser-bar > span {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: #d6e3df;
  }

  .browser-bar > span:first-child { background: #d8877d; }
  .browser-bar > span:nth-child(2) { background: #e6bf5c; }
  .browser-bar > span:nth-child(3) { background: #79b99f; }

  .browser-bar div {
    min-width: 0;
    flex: 1;
    margin-left: 0.5rem;
    padding: 0.38rem 0.7rem;
    border-radius: 0.35rem;
    background: #f2f6f5;
    color: #758984;
    font-family: var(--font-utility);
    font-size: 0.6rem;
  }

  .job-card {
    min-height: 27rem;
    padding: 2rem;
    border-radius: 0 0 1.25rem 1.25rem;
    background: white;
  }

  .job-card > h2 {
    margin-top: 0.2rem;
    font-size: 1.75rem;
    letter-spacing: -0.035em;
  }

  .job-meta {
    color: var(--pounamu-dark);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .company-line {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.3rem;
  }

  .company-avatar {
    display: grid;
    width: 2.5rem;
    height: 2.5rem;
    place-items: center;
    border-radius: 0.55rem;
    background: var(--mist);
    color: var(--pounamu-dark);
    font-family: var(--font-display);
    font-weight: 750;
  }

  .company-line div {
    display: grid;
  }

  .company-line small {
    color: var(--slate);
    font-size: 0.7rem;
  }

  .widget {
    position: relative;
    margin-top: 1rem;
  }

  .widget-trigger {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.25rem 0.65rem 0.25rem 0.3rem;
    border: 1px solid #9dccbb;
    border-radius: 999px;
    background: var(--pounamu-soft);
    color: var(--pounamu-dark);
    font-size: 0.74rem;
  }

  .status-icon {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    place-items: center;
    border-radius: 50%;
    background: var(--pounamu);
  }

  .status-icon svg {
    width: 1rem;
    fill: none;
    stroke: white;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 2.5;
  }

  .chevron { margin-left: 0.25rem; }

  .result-panel {
    position: absolute;
    z-index: 3;
    top: 2.6rem;
    left: 0;
    width: min(27rem, calc(100vw - 5.5rem));
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 0.75rem;
    background: white;
    box-shadow: 0 18px 42px rgb(5 45 53 / 18%);
    animation: panel-in 700ms 220ms both cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(0.7rem); }
  }

  .result-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 1rem;
    border-bottom: 1px solid var(--line-light);
  }

  .result-heading > div {
    display: grid;
  }

  .result-heading small,
  .provenance-row > span {
    color: var(--slate);
    font-size: 0.54rem;
    font-weight: 750;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .result-heading > div > strong {
    font-size: 0.84rem;
  }

  .result-heading > span {
    padding: 0.2rem 0.35rem;
    border-radius: 0.25rem;
    background: var(--mist);
    color: var(--slate);
    font-size: 0.5rem;
    font-weight: 750;
    text-transform: uppercase;
  }

  .provenance-row {
    display: grid;
    padding: 0.55rem 1rem;
    border-bottom: 1px solid var(--line-light);
    border-left: 3px solid var(--pounamu);
    background: #f4f9f7;
  }

  .provenance-row strong {
    color: var(--slate);
    font-size: 0.65rem;
  }

  .employer-row {
    display: grid;
    grid-template-columns: 0.5rem 1fr;
    gap: 0.7rem;
    padding: 0.85rem 1rem;
  }

  .result-dot {
    width: 0.47rem;
    height: 0.47rem;
    margin-top: 0.35rem;
    border-radius: 50%;
    background: var(--pounamu);
    box-shadow: 0 0 0 3px var(--pounamu-soft);
  }

  .employer-row > div > strong { font-size: 0.77rem; }

  dl {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.5rem;
    margin: 0.5rem 0 0;
  }

  dl div { display: grid; }
  dt { color: #78908b; font-size: 0.48rem; text-transform: uppercase; }
  dd { margin: 0; color: var(--slate); font-size: 0.58rem; font-weight: 650; }

  .result-footer {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 1rem;
    border-top: 1px solid var(--line-light);
    color: var(--slate);
    font-size: 0.51rem;
  }

  .result-footer span:last-child {
    color: var(--pounamu-dark);
    font-weight: 700;
  }

  .evidence-path {
    position: absolute;
    right: -2rem;
    bottom: -4.3rem;
    left: 2rem;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.65rem;
    color: var(--slate);
    font-family: var(--font-utility);
    font-size: 0.58rem;
    transform: rotate(-1.2deg);
  }

  .evidence-path span {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }

  .evidence-path b { color: var(--pounamu); }

  .evidence-path i {
    width: clamp(1rem, 3vw, 3rem);
    height: 1px;
    background: var(--line);
  }

  .support-strip {
    border-block: 1px solid var(--line);
    background: white;
  }

  .support-inner {
    display: flex;
    min-height: 5.5rem;
    align-items: center;
